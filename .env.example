# ============================================================================
# Telegram 云控 —— 环境变量样例（复制成 .env 后使用）
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# 约定：
#   1. 带「应用」标记的键 = backend/app/config.py 里的字段，名字必须一字不差；
#      带「部署」标记的键只给 docker-compose.yml / deploy/*.sh 用，应用不读。
#   2. .env 已被 .gitignore 与 backend/.dockerignore 排除：不进版本库、不进镜像。
#   3. 改完 .env 要 docker compose up -d --force-recreate 让容器重新读取。
#   4. 三个密钥（POSTGRES_PASSWORD / SECRET_KEY / SESSION_ENCRYPTION_KEY）上线必须换，
#      生成方式见下面各段。密钥一旦有号登录过就不要再改：已入库的会话解不开。
# ============================================================================

# ---------------------------------------------------------------- 基础 [应用]
APP_NAME=Telegram 云控
# development | production。样例给 development 方便本地先跑通；
# 上线前改成 production：entrypoint 会强制要求 SECRET_KEY / SESSION_ENCRYPTION_KEY 非空，缺一个就拒绝启动。
ENVIRONMENT=development
DEBUG=false
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# 日志里的组件名，compose 会按服务覆盖成 api / worker
COMPONENT=api

# ---------------------------------------------------------------- 数据库 / Redis [应用]
# 容器内连服务名 postgres（不是 localhost）。口令含 @ : / 等字符要 URL 编码。
# 改 POSTGRES_PASSWORD 时这里要同步改。
DATABASE_URL=postgresql+asyncpg://cloudctl:change-me-postgres-password@postgres:5432/cloudctl
# 连接池：pool_size + max_overflow 是单进程上限，乘以 api+worker 进程数要小于
# Postgres 的 max_connections（见 POSTGRES_MAX_CONNECTIONS）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# 打印每条 SQL（排查用，平时 false，否则日志量很大）
DB_ECHO=false

# 只存心跳缓存 / 页面推送 / update_id 去重，丢了不影响事实数据
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- 安全 [应用]
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT 签名 + （未单独配 SESSION_ENCRYPTION_KEY 时）派生会话加密密钥
SECRET_KEY=
# 会话 / Bot Token 的 Fernet 加密密钥（44 字符 urlsafe base64）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空则退化为由 SECRET_KEY 派生（仅限本地开发；上线必须单独设置）
SESSION_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
# 登录令牌有效期（分钟），默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 首次启动 / make admin 用的管理员账号；口令留空则跳过自动初始化
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Telegram [应用]
# API ID / API HASH 从 https://my.telegram.org → API development tools 申请（用自己要挂的号登录申请）
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# 登录时上报给 Telegram 的设备信息，同一批号保持一致即可
TELEGRAM_DEVICE_MODEL=Cloud Control
TELEGRAM_SYSTEM_VERSION=Linux
TELEGRAM_APP_VERSION=1.0
# 登录验证码会话有效期（秒），超时要重新发码
LOGIN_SESSION_TTL_SECONDS=900

# ---------------------------------------------------------------- 租约 / 任务 [应用]
# 留空 = 每个副本用「容器主机名-进程号」生成唯一 worker_id。
# 多副本时千万不要写死，否则副本之间会互相抢租约。
WORKER_ID=
# 租约 30 秒过期，Worker 每 10 秒续租（改这两个值要保证 renew < ttl）
LEASE_TTL_SECONDS=30
LEASE_RENEW_SECONDS=10
# 一个 Worker 副本承载多少个在线号（扩容按这个估：200 个在线号 → 2 个副本）
ACCOUNTS_PER_REPLICA=100
TASK_BATCH=10
TASK_POLL_INTERVAL=2.0
TASK_MAX_ATTEMPTS=5
# 失败退避：10s 起，指数增长，封顶 600s
TASK_RETRY_BASE_SECONDS=10
TASK_RETRY_MAX_SECONDS=600
# Worker 指标端口（容器内固定 9101；宿主映射见 WORKER_METRICS_PORT_RANGE）
WORKER_METRICS_PORT=9101
# API 若单独暴露指标端口用；/metrics 挂在 8000 上时这个值不生效
API_METRICS_PORT=9100
# 号掉线后的重连退避：15s 起，最长 300s
ACCOUNT_RECONNECT_BACKOFF_SECONDS=15
ACCOUNT_RECONNECT_BACKOFF_MAX_SECONDS=300

# ---------------------------------------------------------------- API / Bot [应用]
API_HOST=0.0.0.0
API_PORT=8000
# 必须是 Telegram 能访问到的公网地址（域名或公网 IP），Webhook 就注册到
# <PUBLIC_BASE_URL>/api/webhook/{bot_id}/{WEBHOOK_SECRET}；写 localhost 会导致注册失败
PUBLIC_BASE_URL=https://tg.example.com
# Telegram 回调路径里的共享密钥
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# 允许的前端来源，多个用逗号分隔；* 表示不限制（仅本地开发用）
CORS_ORIGINS=*
# API 侧轮询 Bot 任务的间隔（秒）
BOT_TASK_POLL_INTERVAL=1.0

# ---------------------------------------------------------------- AI [应用]
# 只用于「生成草稿放输入框」，员工点发送才发出去；关掉不影响其它功能
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY=20

# ---------------------------------------------------------------- 转发 [应用]
# 转发到员工群时是否带上「来源：哪个号 / 群还是私信 / 对方是谁」的头
RELAY_INCLUDE_SOURCE_HEADER=true

# ============================================================================
# 以下为部署专用键（docker-compose.yml / deploy/*.sh 使用，应用不读）
# ============================================================================

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=cloudctl
# ⚠️ 上线必须换成强口令，并同步改 DATABASE_URL 里的口令部分。
# 留空时 docker-compose.yml 的 `${POSTGRES_PASSWORD:-cloudctl}` 会退回默认值 cloudctl
# （容器仍起得来），但 DATABASE_URL 不同步就会连不上库。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=cloudctl
# 宿主机暴露方式，默认只绑定 127.0.0.1（不对公网开放数据库）
POSTGRES_PUBLISH=127.0.0.1:5432
# 连接数上限：要 > (api + worker 副本数) × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + 运维连接
POSTGRES_MAX_CONNECTIONS=200
# 一般给宿主内存的 25%
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
# 归档保留的 WAL 量（给 pg_basebackup 留出复制时间）
POSTGRES_WAL_KEEP_SIZE=512MB
# 慢 SQL 阈值（毫秒），低于这个值不记日志
POSTGRES_LOG_MIN_DURATION_MS=1000

# ---------------------------------------------------------------- Redis
REDIS_MAXMEMORY=256mb
REDIS_PUBLISH=127.0.0.1:6379

# ---------------------------------------------------------------- 端口 / 镜像
# 控制台前端端口（nginx）
WEB_PORT=8080
# Worker 指标在宿主的端口区间，支持 --scale worker=N（容器内固定 9101）
WORKER_METRICS_PORT_RANGE=9101-9110
# 镜像 tag，compose 构建出的 api/worker（tgcc-backend）与前端（tgcc-frontend）共用
TAG=local
TZ=Asia/Shanghai
COMPOSE_NETWORK=tgcc-net

# ---------------------------------------------------------------- 监控（profile: monitoring）
PROMETHEUS_PORT=9090
# 指标原始数据保留时长
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
PUSHGATEWAY_PORT=9091
POSTGRES_EXPORTER_PORT=9187

# ---------------------------------------------------------------- 备份（deploy/backup.sh）
# 备份落盘目录（宿主路径，脚本自动创建）
BACKUP_DIR=./backups
# docker = 用 docker compose exec 在 postgres 容器里跑（推荐，宿主不需要装客户端）
# direct = 宿主直连，需要本机有 pg_dump / pg_basebackup，读 PG* 变量
BACKUP_MODE=docker
# 保留份数：日备 7 份、周备（基础备份）4 份，超期自动删除
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# 备份脚本上报位置；留空时 docker 模式用 http://pushgateway:9091，direct 模式用宿主端口
BACKUP_PUSHGATEWAY_URL=
# direct 模式直连参数（docker 模式忽略）
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=cloudctl
PGPASSWORD=

# ---------------------------------------------------------------- 启动等待（backend/entrypoint.sh）
# 等 Postgres：次数 × 间隔（默认 60 × 2s = 120s）
DB_WAIT_ATTEMPTS=60
DB_WAIT_INTERVAL=2
# Worker 等迁移完成：默认 150 × 2s = 300s
SCHEMA_WAIT_ATTEMPTS=150

# ============================================================================
# 最小可跑示例（本地 docker compose）
# ============================================================================
# cp .env.example .env 之后，至少把下面 5 项填上，其余保持默认即可跑起来：
#
#   1) POSTGRES_PASSWORD  改成长随机串，并同步改 DATABASE_URL 里的口令部分
#   2) SECRET_KEY         python -c "import secrets; print(secrets.token_urlsafe(48))"
#   3) SESSION_ENCRYPTION_KEY
#                         python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   4) TELEGRAM_API_ID / TELEGRAM_API_HASH   从 my.telegram.org 申请
#   5) BOOTSTRAP_ADMIN_PASSWORD   控制台 admin 的口令（不给就 make admin 时再给）
#
# 命令顺序：
#   docker compose up -d postgres redis
#   make migrate
#   docker compose up -d api worker frontend
#   make admin ADMIN_PASSWORD='你的口令'
#   打开 http://localhost:8080 登录；监控另起：make monitoring
#
# Bot Token 不在 .env 里：登录控制台后在「Bot 转发」页填，库里加密保存。
